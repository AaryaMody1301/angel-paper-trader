# Copy to .env and edit locally. Never commit the populated file.
# Literal KEY=VALUE only; optional matching quotes; no export/interpolation.
# PIN and current TOTP are entered at hidden local prompts, not stored here.
ANGEL_API_KEY=YOUR_API_KEY
ANGEL_CLIENT_CODE=YOUR_CLIENT_CODE
ANGEL_LOCAL_IP=YOUR_LOCAL_IPV4
ANGEL_PUBLIC_IP=YOUR_REGISTERED_STATIC_PUBLIC_IPV4
ANGEL_MAC_ADDRESS=YOUR_MAC_ADDRESS
